{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/download/:file(VelocityBlocks\\.apk|VelocityBlocks-Setup\\.exe|VelocityBlocks-Portable\\.exe)",
      "destination": "https://github.com/Mitovoid-AI/VelocityBlocks/releases/latest/download/:file",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/play/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.glb",
      "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }]
    },
    {
      "source": "/(.*)\\.ktx2",
      "headers": [{ "key": "Content-Type", "value": "image/ktx2" }]
    },
    {
      "source": "/video/(.*)\\.m3u8",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.apple.mpegurl" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/video/(.*)\\.m4s",
      "headers": [
        { "key": "Content-Type", "value": "video/iso.segment" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/video/(.*)\\.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
