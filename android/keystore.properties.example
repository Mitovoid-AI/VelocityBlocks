# Copy to android/keystore.properties (git-ignored) and fill in your own values.
# Create the upload key once (keep the .jks file and both passwords safe; Google Play needs the
# same key for every update):
#   keytool -genkeypair -v -keystore velocity-upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# keytool ships with Android Studio's JDK (Android Studio\jbr\bin\keytool.exe).
storeFile=../velocity-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
