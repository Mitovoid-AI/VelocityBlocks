<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|touchscreen|screenSize|smallestScreenSize|screenLayout|uiMode|locale|layoutDirection|fontScale"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Shared runs: a link to the browser game with a run in it opens here when the app is installed.
                 autoVerify: Android 12+ opens https links in an app only when the site vouches for it
                 (site/.well-known/assetlinks.json, with the release key's certificate). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="velocityblocks.vercel.app" android:pathPrefix="/play" />
            </intent-filter>
            <!-- velocityblocks://run#run=... from the browser game's "Open in the app" (also the Windows app's). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="velocityblocks" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- navigator.vibrate (checkpoint haptics) is silently ignored by WebView without it. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Profile photo Camera button (<input capture>): Capacitor only launches the camera if
         resolveActivity(ACTION_IMAGE_CAPTURE) finds an app (BridgeWebChromeClient), and package
         visibility (API 30+) hides it without this, so the button would open the gallery.
         No CAMERA permission on purpose: undeclared, the capture intent needs no prompt. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
